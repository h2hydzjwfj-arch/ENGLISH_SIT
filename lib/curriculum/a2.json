      "id": "ling-01",
      "title": "Present Continuous",
      "level": "A2",
      "grammar": "Действие происходит прямо сейчас. Форма: am/is/are + глагол-ing. I am reading. She is working. They are playing.",
      "exercises": [
        {
          "q": "She ___ reading a book right now.",
          "options": [
            "is",
            "are",
            "am",
            "be"
          ],
          "correct": 0
        },
        {
          "q": "They ___ playing football at the moment.",
          "options": [
            "is",
            "are",
            "was",
            "be"
          ],
          "correct": 1
        },
        {
          "q": "I ___ not sleeping.",
          "options": [
            "am",
            "is",
            "are",
            "be"
          ],
          "correct": 0
        },
        {
          "q": "___ you listening to me?",
          "options": [
            "Am",
            "Is",
            "Are",
            "Do"
